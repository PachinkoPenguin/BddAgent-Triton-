# Triton GPU kernel grammar (GBNF for Ollama/llama.cpp constrained generation)
#
# Enforced structure:
#   1. Mandatory imports (torch, triton, triton.language as tl)
#   2. @triton.jit decorated kernel function
#   3. Host-side launch function
#
# The function bodies are intentionally permissive (any indented lines) so
# the grammar constrains *shape* without blocking valid Triton expressions.

root ::= imports nl+ triton-kernel nl+ launch-function nl*

# ── Imports ──────────────────────────────────────────────────────────────────

imports ::= "import torch" nl "import triton" nl "import triton.language as tl" nl

# ── Kernel function (@triton.jit) ─────────────────────────────────────────────

triton-kernel ::= "@triton.jit" nl funcdef

# ── Launch function ───────────────────────────────────────────────────────────

launch-function ::= funcdef

# ── Generic Python function definition ───────────────────────────────────────

funcdef ::= "def " identifier "(" func-args "):" nl body

# Parameter content: anything except a closing paren.
# Handles both single-line and multi-line parameter lists.
func-args ::= [^)]*

# ── Function body ─────────────────────────────────────────────────────────────
# One or more lines that either:
#   • start with at least one space (indented code / nested blocks)
#   • are blank (empty separator lines within the body)

body ::= body-line+
body-line ::= " "+ [^\n]* nl | nl

# ── Primitives ────────────────────────────────────────────────────────────────

identifier ::= [a-zA-Z_] [a-zA-Z0-9_]*
nl          ::= "\n"
