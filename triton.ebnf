# triton.ebnf - Focused on strict Kernel structure
root ::= kernel_block

kernel_block ::= imports newline decorator newline func_def

imports ::= "import torch" newline "import triton" newline "import triton.language as tl"

decorator ::= "@triton.jit"

func_def ::= "def " identifier "(" arg_list "):" newline block

arg_list ::= identifier ("," ws identifier)* ("," ws identifier ":" ws type_hint)*

block ::= (ws statement newline)+

statement ::= assignment | triton_call | for_loop | comment

assignment ::= identifier ws "=" ws expression
triton_call ::= "tl." identifier "(" expression_list ")"
for_loop ::= "for " identifier " in range(" expression "):" newline ws ws statement

type_hint ::= "tl.constexpr"
identifier ::= [a-zA-Z_][a-zA-Z0-9_]*
newline ::= "\n"
ws ::= " "
expression ::= [^\n]+
